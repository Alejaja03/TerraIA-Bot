@client.event
async def on_ready():
    print(f'Hemos iniciado sesión como {client.user}')


@client.event
async def on_message(message):
    if message.author == client.user:
        return

    if message.content.startswith('$hello'):
        await message.channel.send('¡Hola! Soy el bot ecológico TerraIA ')

    elif message.content.startswith('$ayuda'):
        await message.channel.send(
            'Aquí tienes algunos comandos para seguir aprendiendo juntos sobre nuestro planeta, Comandos: $hello, $ayuda, $objetivo, $agua, $ia, $clima y $soluciones'
        )

    elif message.content.startswith('$objetivo'):
        await message.channel.send(
            '¡Hola! Soy TerraIA , un bot ecológico que te ayudará a '
            'aprender sobre el impacto ambiental de la inteligencia artificial, '
            'el consumo de agua, el cambio climático y las soluciones que podemos '
            'aplicar para cuidar nuestro planeta. ¡Aprendamos juntos a construir '
            'un futuro más sostenible! '
        )

    elif message.content.startswith('$agua'):
        dato = random.choice(datos_agua)
        await message.channel.send(f' Dato sobre el agua: {dato}')

    elif message.content.startswith('$ia'):
        dato = random.choice(datos_ia)
        await message.channel.send(f' Dato sobre la IA: {dato}')

    elif message.content.startswith('$clima'):
        dato = random.choice(datos_clima)
        await message.channel.send(f' Dato sobre el clima: {dato}')

    elif message.content.startswith('$soluciones'):
        dato = random.choice(datos_soluciones)
        await message.channel.send(f' Consejo ecológico: {dato}')

